# The build only needs pyproject.toml, uv.lock and pdf2md/.
# .env in particular must never land in an image layer: it holds API keys.
.env
.env.*
!.env.example

.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.gitignore

# UI-only and test-only trees; the API image ships neither.
app.py
tests/

README.md
Dockerfile
.dockerignore
compose.yaml
