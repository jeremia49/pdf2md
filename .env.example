# Copy to .env and fill in. The Streamlit sidebar can override any value per run;
# .env only supplies the defaults.

# --- Stage 1: Unlimited-OCR (vLLM, OpenAI-compatible /v1/chat/completions) ---
# This value is for running pdf2md on the HOST: unlimited-ocr-container publishes
# its 8000 as 127.0.0.1:5000. Under `docker compose up`, compose.yaml overrides
# this with http://unlimited-ocr:8000 (container-to-container over `ocr-net`).
OCR_BASE_URL=http://127.0.0.1:5000
# Must equal VLLM_API_KEY of the OCR container. Both empty = no auth.
OCR_API_KEY=
OCR_MODEL=baidu/Unlimited-OCR
OCR_DPI=300
# max_tokens + prompt tokens must stay under max_model_len (32768).
OCR_MAX_TOKENS=10000
OCR_TIMEOUT=1800
OCR_CONCURRENCY=4
OCR_RETRIES=4
OCR_FIGURE_PAD=6

# --- Stage 2: vision LLM that explains the figures ---
# Pass the /v1 root: the SDK appends /chat/completions.
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-4o
VISION_TIMEOUT=300
VISION_TEMPERATURE=0.2
VISION_MAX_TOKENS=4096
VISION_CONCURRENCY=4
VISION_RETRIES=3
# Leave empty to use the built-in Indonesian figure prompt.
VISION_PROMPT=

# --- Stage 4: repeated header/footer removal ---
CLEANUP_ENABLED=1
# Fraction of pages a line must appear on to count as chrome.
CLEANUP_MIN_RATIO=0.6
CLEANUP_MIN_PAGES=3
# Leading/trailing lines per page eligible for removal.
CLEANUP_ZONE_LINES=3
CLEANUP_DROP_PAGE_NUMBERS=1

# --- Output ---
# 1 keeps the ![](figures/...) link next to the description, 0 replaces it.
KEEP_IMAGE_LINK=0

# --- HTTP API (pdf2md/api.py) ---
# Kosong = server terbuka tanpa autentikasi. Isi untuk mewajibkan header X-API-Key.
API_KEY=
API_MAX_UPLOAD_MB=50
# Berapa PDF diproses sekaligus; sisanya mengantre. Tiap run sudah memakai
# OCR_CONCURRENCY + VISION_CONCURRENCY thread sendiri.
API_MAX_CONCURRENT=2
